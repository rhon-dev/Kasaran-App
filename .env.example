# .env.example — copy to .env.local and fill in real values.
#
# .env.local is gitignored (deployment-plan §2.5, SEC-26).
# NEVER commit .env.local or any file containing a real key.
#
# These vars are passed to flutter run/build via --dart-define.
# See lib/config/app_config.dart for usage.
#
# Local dev (supabase start):
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
ENV=local

# Staging (ap-southeast-1 — OQ-07 descoped: staging only):
# SUPABASE_URL=https://<staging-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<staging-anon-key>
# ENV=staging

# Production (DEFERRED — OQ-07 OPEN — do not create until resolved):
# SUPABASE_URL=https://<prod-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<prod-anon-key>
# ENV=production

# ─── NEVER put these in this file or any file tracked by git ────────────────
# SUPABASE_SERVICE_ROLE_KEY=...   ← CI secret only (SEC-26)
# MATCH_PASSWORD=...              ← CI secret only
# APP_STORE_CONNECT_API_KEY_CONTENT=...  ← CI secret only
